rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isAdmin() {
      return hasProfile()
        && (
          profile().rol == 'administrador'
          || (profile().rol == 'funcionario' && profile().dependencia == 'Control Interno')
        );
    }

    function isFuncionario() {
      return hasProfile() && profile().rol == 'funcionario';
    }

    function isEmployeeOf(dependencia) {
      return hasProfile()
        && profile().rol == 'funcionario'
        && profile().dependencia == dependencia;
    }

    function isLegal() {
      return hasProfile()
        && profile().rol == 'funcionario'
        && profile().dependencia == 'Oficina Juridica';
    }

    function canReadIAS() {
      return isAdmin() || isLegal();
    }

    function canManageIAS() {
      return isAdmin() || isLegal();
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    match /radicados/{radicadoId} {
      allow get, list: if isAdmin() || isEmployeeOf(resource.data.dependencia);
      allow create: if isAdmin()
        || (
          isEmployeeOf(request.resource.data.dependencia)
          && request.resource.data.keys().hasAll([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia'
          ])
          && (
            !request.resource.data.keys().hasAny(['fechaHoraRadicacion'])
            || request.resource.data.fechaHoraRadicacion is string
          )
          && request.resource.data.origenSolicitud == 'ventanilla'
        )
        || (
          isFuncionario()
          && request.resource.data.remisionOrigenId is string
          && request.resource.data.remisionOrigenColeccion == 'radicados'
          && request.resource.data.remisionOrigenDependencia == profile().dependencia
          && request.resource.data.dependencia != profile().dependencia
          && request.resource.data.keys().hasAll([
            'radicado',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia',
            'funcionarioAsignado',
            'otrosEstados',
            'respuestaUrl',
            'observaciones',
            'dependenciasRecibidas',
            'dependenciasRechazadas',
            'dependenciasDestino',
            'remisionOrigenId',
            'remisionOrigenColeccion',
            'remisionOrigenDependencia',
            'remisionOrigenRadicado',
            'fechaRemisionCompetencia',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia',
            'tipoPeticion',
            'funcionarioAsignado',
            'otrosEstados',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'observaciones',
            'dependenciasRecibidas',
            'dependenciasRechazadas',
            'rechazosCompetencia',
            'recepcionesCompetencia',
            'dependenciasDestino',
            'remisionOrigenId',
            'remisionOrigenColeccion',
            'remisionOrigenDependencia',
            'remisionOrigenRadicado',
            'fechaRemisionCompetencia',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.dependencia in [
            'Secretaría de Gobierno',
            'Secretaría de Planeación',
            'Oficina de Gestion del Riesgo y Desastres',
            'Oficina de Desarrollo Social',
            'Secretaría de Salud',
            'Control Interno',
            'Oficina Juridica',
            'Despacho del Alcalde',
            'Secretaría de Umata',
            'Secretaría de Educación',
            'Secretaría de Hacienda',
            'Sisben',
            'Talento Humano',
            'Secretaría de Transito y Transporte',
            'Gestion Social'
          ]
          && getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.dependencia == profile().dependencia
          && getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.dependenciasDestino.hasAny([request.resource.data.dependencia])
          && request.resource.data.radicado == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.radicado
          && request.resource.data.remitente == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.remitente
          && request.resource.data.asunto == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.asunto
          && request.resource.data.tipoCanal == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.tipoCanal
          && request.resource.data.fechaRadicacion == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.fechaRadicacion
          && request.resource.data.diasHabiles == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.diasHabiles
          && request.resource.data.fechaVencimiento == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.fechaVencimiento
          && request.resource.data.pdfUrl == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.pdfUrl
          && request.resource.data.estado == 'VIGENTE'
          && request.resource.data.funcionarioAsignado == ''
          && request.resource.data.otrosEstados == ''
          && request.resource.data.respuestaUrl == ''
          && request.resource.data.observaciones == ''
          && request.resource.data.fechaEntregaManual == ''
          && request.resource.data.fechaRecepcionCompetencia == ''
          && request.resource.data.remisionOrigenRadicado == request.resource.data.radicado
        );
      allow update: if isAdmin()
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tipoPeticion',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'funcionarioAsignado',
            'otrosEstados',
            'observaciones',
            'estado'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.resource.data.estado == resource.data.estado
            || request.resource.data.estado in ['VIGENTE', 'EN TRAMITE', 'CERRADO']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuestaUrl'])
            || request.resource.data.respuestaUrl is string
          )
        )
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasDestino',
            'fechaRemisionCompetencia'
          ])
          && request.resource.data.dependenciasDestino is list
          && request.resource.data.dependenciasDestino.size()
            > resource.data.get('dependenciasDestino', []).size()
          && request.resource.data.dependenciasDestino.hasAll(
            resource.data.get('dependenciasDestino', [])
          )
          && request.resource.data.fechaRemisionCompetencia is string
          && request.resource.data.fechaRemisionCompetencia.size() > 0
        )
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && resource.data.remisionOrigenId is string
          && resource.data.remisionOrigenId.size() > 0
          && (
            !resource.data.keys().hasAny(['fechaRecepcionCompetencia'])
            || resource.data.fechaRecepcionCompetencia == ''
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fechaEntregaManual',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.fechaEntregaManual is string
          && request.resource.data.fechaRecepcionCompetencia is string
          && request.resource.data.fechaEntregaManual == request.resource.data.fechaRecepcionCompetencia
          && request.resource.data.fechaRecepcionCompetencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRecibidas',
            'recepcionesCompetencia',
            'estado'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'dependenciasRecibidas'
          ])
          && request.resource.data.estado == 'R. por C.'
          && request.resource.data.dependenciasRecibidas is list
          && request.resource.data.dependenciasRecibidas.size()
            == resource.data.get('dependenciasRecibidas', []).size() + 1
          && request.resource.data.dependenciasRecibidas.hasAll(
            resource.data.get('dependenciasRecibidas', [])
          )
          && request.resource.data.dependenciasRecibidas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRecibidas', []).hasAny([profile().dependencia])
          && request.resource.data.recepcionesCompetencia is list
          && request.resource.data.recepcionesCompetencia.size()
            == resource.data.get('recepcionesCompetencia', []).size() + 1
          && request.resource.data.recepcionesCompetencia.hasAll(
            resource.data.get('recepcionesCompetencia', [])
          )
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].fechaRecepcion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRechazadas',
            'rechazosCompetencia'
          ])
          && request.resource.data.dependenciasRechazadas is list
          && request.resource.data.dependenciasRechazadas.size()
            == resource.data.get('dependenciasRechazadas', []).size() + 1
          && request.resource.data.dependenciasRechazadas.hasAll(
            resource.data.get('dependenciasRechazadas', [])
          )
          && request.resource.data.dependenciasRechazadas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRechazadas', []).hasAny([profile().dependencia])
          && request.resource.data.rechazosCompetencia is list
          && request.resource.data.rechazosCompetencia.size()
            == resource.data.get('rechazosCompetencia', []).size() + 1
          && request.resource.data.rechazosCompetencia.hasAll(
            resource.data.get('rechazosCompetencia', [])
          )
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].fechaRechazo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
      allow delete: if isAdmin()
        || (
          isEmployeeOf(resource.data.dependencia)
          && resource.data.remisionOrigenId is string
          && resource.data.remisionOrigenId.size() > 0
          && (
            !resource.data.keys().hasAny(['fechaRecepcionCompetencia'])
            || resource.data.fechaRecepcionCompetencia == ''
          )
          && (
            (
              resource.data.get('remisionOrigenColeccion', 'radicados') == 'radicados'
              && getAfter(
                /databases/$(database)/documents/radicados/$(resource.data.remisionOrigenId)
              ).data.dependenciasRechazadas.hasAny([profile().dependencia])
            )
            || (
              resource.data.remisionOrigenColeccion == 'radicadosIAS'
              && getAfter(
                /databases/$(database)/documents/radicadosIAS/$(resource.data.remisionOrigenId)
              ).data.dependenciasRechazadas.hasAny([profile().dependencia])
            )
          )
        );
    }

    match /radicadosIAS/{radicadoId} {
      allow read: if canReadIAS();
      allow create: if canManageIAS()
        && request.resource.data.keys().hasOnly([
          'radicado',
          'entidadIAS',
          'destino',
          'tipoCanal',
          'estado',
          'fechaRadicacion',
          'fechaHoraRadicacion',
          'diasHabiles',
          'fechaVencimiento',
          'remitente',
          'asunto',
          'pdfUrl',
          'funcionarioAsignado',
          'tipoPeticion',
          'otrosEstados',
          'observaciones',
          'respuestaUrl',
          'fechaCargaRespuesta'
        ])
        && request.resource.data.keys().hasAll([
          'radicado',
          'entidadIAS',
          'destino',
          'tipoCanal',
          'estado',
          'fechaRadicacion',
          'diasHabiles',
          'fechaVencimiento',
          'remitente',
          'asunto',
          'pdfUrl'
        ])
        && request.resource.data.radicado is string
        && request.resource.data.entidadIAS is string
        && request.resource.data.destino is string
        && request.resource.data.fechaRadicacion is string
        && (
          !request.resource.data.keys().hasAny(['fechaHoraRadicacion'])
          || request.resource.data.fechaHoraRadicacion is string
        );
      allow update: if isAdmin()
        || (
          canManageIAS()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'radicado',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'funcionarioAsignado',
            'tipoPeticion',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'estado',
            'otrosEstados',
            'observaciones'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.resource.data.estado in ['VIGENTE', 'EN TRAMITE', 'CERRADO', 'R. por C.']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuestaUrl'])
            || request.resource.data.respuestaUrl is string
          )
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRecibidas',
            'recepcionesCompetencia',
            'estado'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'dependenciasRecibidas'
          ])
          && request.resource.data.estado == 'R. por C.'
          && request.resource.data.dependenciasRecibidas is list
          && request.resource.data.dependenciasRecibidas.size()
            == resource.data.get('dependenciasRecibidas', []).size() + 1
          && request.resource.data.dependenciasRecibidas.hasAll(
            resource.data.get('dependenciasRecibidas', [])
          )
          && request.resource.data.dependenciasRecibidas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRecibidas', []).hasAny([profile().dependencia])
          && request.resource.data.recepcionesCompetencia is list
          && request.resource.data.recepcionesCompetencia.size()
            == resource.data.get('recepcionesCompetencia', []).size() + 1
          && request.resource.data.recepcionesCompetencia.hasAll(
            resource.data.get('recepcionesCompetencia', [])
          )
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].fechaRecepcion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRechazadas',
            'rechazosCompetencia'
          ])
          && request.resource.data.dependenciasRechazadas is list
          && request.resource.data.dependenciasRechazadas.size()
            == resource.data.get('dependenciasRechazadas', []).size() + 1
          && request.resource.data.dependenciasRechazadas.hasAll(
            resource.data.get('dependenciasRechazadas', [])
          )
          && request.resource.data.dependenciasRechazadas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRechazadas', []).hasAny([profile().dependencia])
          && request.resource.data.rechazosCompetencia is list
          && request.resource.data.rechazosCompetencia.size()
            == resource.data.get('rechazosCompetencia', []).size() + 1
          && request.resource.data.rechazosCompetencia.hasAll(
            resource.data.get('rechazosCompetencia', [])
          )
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].fechaRechazo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
      allow delete: if isAdmin();
    }

    match /radicadosSalida/{radicadoId} {
      allow get, list: if isAdmin() || isFuncionario();
      allow create: if isAdmin()
        || (
          isFuncionario()
          && request.resource.data.keys().hasAll([
            'radicado',
            'dependencia',
            'destinatario',
            'asunto',
            'folios',
            'anexos',
            'claveIdempotencia',
            'numeroSecuencia',
            'anio',
            'mes',
            'fechaGeneracion',
            'horaGeneracion',
            'creadoEn',
            'actualizadoEn'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'dependencia',
            'dependenciaOtra',
            'destinatario',
            'asunto',
            'folios',
            'anexos',
            'archivos',
            'claveIdempotencia',
            'numeroSecuencia',
            'anio',
            'mes',
            'fechaGeneracion',
            'horaGeneracion',
            'creadoEn',
            'actualizadoEn',
            'cantidadLote',
            'tipoLoteRadicados',
            'extremoLote'
          ])
        );
      allow update: if isAdmin()
        || (
          isFuncionario()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependencia',
            'destinatario',
            'asunto',
            'folios',
            'anexos',
            'dependenciaOtra',
            'archivos',
            'actualizadoEn',
            'estado',
            'anuladoEn'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.resource.data.estado == 'ANULADO'
          )
        );
      allow delete: if isAdmin();
    }

    match /radicadosSalidaSecuencias/{secuenciaId} {
      allow get: if isAdmin() || isFuncionario();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (
          isFuncionario()
          && request.resource.data.keys().hasOnly(['anio', 'ultimo'])
          && request.resource.data.anio is int
          && request.resource.data.ultimo is int
          && request.resource.data.ultimo > 0
        );
      allow update: if isAdmin()
        || (
          isFuncionario()
          && request.resource.data.keys().hasOnly(['anio', 'ultimo'])
          && request.resource.data.anio == resource.data.anio
          && request.resource.data.ultimo is int
          && resource.data.ultimo is int
          && request.resource.data.ultimo > resource.data.ultimo
          && request.resource.data.ultimo <= resource.data.ultimo + 400
        );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
