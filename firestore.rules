rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isAdmin() {
      return hasProfile()
        && (
          profile().rol == 'administrador'
          || (profile().rol == 'funcionario' && profile().dependencia == 'Control Interno')
        );
    }

    function isAdministradorEstricto() {
      return hasProfile() && profile().rol == 'administrador';
    }

    function isFuncionario() {
      return hasProfile() && profile().rol == 'funcionario';
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isInvitado() {
      return isAnonymous() && hasProfile() && profile().rol == 'invitado';
    }

    function isCiudadano() {
      return isAnonymous() && hasProfile() && profile().rol == 'ciudadano';
    }

    function tieneRadicadoCiudadanoDespues(anio, numero, radicado) {
      let radicadoPath = /databases/$(database)/documents/radicados/$(radicado);
      return existsAfter(radicadoPath)
        && getAfter(radicadoPath).data.origenSolicitud == 'ciudadano'
        && getAfter(radicadoPath).data.ciudadanoUid == request.auth.uid
        && getAfter(radicadoPath).data.anio == anio
        && getAfter(radicadoPath).data.numeroSecuencia == numero
        && getAfter(radicadoPath).data.radicado == radicado
        && getAfter(radicadoPath).data.estado == 'PENDIENTE_GESTION'
        && getAfter(radicadoPath).data.dependencia == 'Ventanilla Única';
    }

    function tieneSecuenciaCiudadanaDespues(anio, numero, radicado) {
      let secuenciaPath = /databases/$(database)/documents/radicadosEntradaSecuencias/$(string(anio));
      return existsAfter(secuenciaPath)
        && getAfter(secuenciaPath).data.anio == anio
        && getAfter(secuenciaPath).data.ultimo == numero
        && getAfter(secuenciaPath).data.ultimoRadicado == radicado
        && (
          exists(secuenciaPath)
            ? getAfter(secuenciaPath).data.ultimo == get(secuenciaPath).data.ultimo + 1
            : getAfter(secuenciaPath).data.ultimo == 1
        );
    }

    function isEmployeeOf(dependencia) {
      return hasProfile()
        && profile().rol == 'funcionario'
        && profile().dependencia == dependencia;
    }

    function isLegal() {
      return hasProfile()
        && profile().rol == 'funcionario'
        && profile().dependencia == 'Oficina Juridica';
    }

    function canReadIAS() {
      return isAdmin() || isLegal();
    }

    function canManageIAS() {
      return isAdmin() || isLegal();
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (
          isAnonymous()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['rol', 'nombre'])
          && request.resource.data.keys().hasOnly(['rol', 'nombre'])
          && request.resource.data.rol in ['invitado', 'ciudadano']
          && request.resource.data.nombre
            == (request.resource.data.rol == 'ciudadano' ? 'Ciudadano' : 'Invitado')
        );
    }

    match /radicados/{radicadoId} {
      allow get: if isAdmin()
        || isEmployeeOf(resource.data.dependencia)
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
        )
        || (
          isCiudadano()
          && resource.data.origenSolicitud == 'ciudadano'
          && resource.data.ciudadanoUid == request.auth.uid
        );
      allow list: if isAdmin() || isEmployeeOf(resource.data.dependencia);
      allow create: if isAdmin()
        || (
          isEmployeeOf(request.resource.data.dependencia)
          && request.resource.data.keys().hasAll([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia'
          ])
          && (
            !request.resource.data.keys().hasAny(['fechaHoraRadicacion'])
            || request.resource.data.fechaHoraRadicacion is string
          )
          && request.resource.data.origenSolicitud == 'ventanilla'
        )
        || (
          isFuncionario()
          && request.resource.data.remisionOrigenId is string
          && request.resource.data.remisionOrigenColeccion == 'radicados'
          && request.resource.data.remisionOrigenDependencia == profile().dependencia
          && request.resource.data.dependencia != profile().dependencia
          && request.resource.data.keys().hasAll([
            'radicado',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia',
            'funcionarioAsignado',
            'otrosEstados',
            'respuestaUrl',
            'observaciones',
            'dependenciasRecibidas',
            'dependenciasRechazadas',
            'dependenciasDestino',
            'remisionOrigenId',
            'remisionOrigenColeccion',
            'remisionOrigenDependencia',
            'remisionOrigenRadicado',
            'fechaRemisionCompetencia',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'dependencia',
            'tipoPeticion',
            'funcionarioAsignado',
            'otrosEstados',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'observaciones',
            'dependenciasRecibidas',
            'dependenciasRechazadas',
            'rechazosCompetencia',
            'recepcionesCompetencia',
            'dependenciasDestino',
            'remisionOrigenId',
            'remisionOrigenColeccion',
            'remisionOrigenDependencia',
            'remisionOrigenRadicado',
            'fechaRemisionCompetencia',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.dependencia in [
            'Secretaría de Gobierno',
            'Secretaría de Planeación',
            'Oficina de Gestion del Riesgo y Desastres',
            'Oficina de Desarrollo Social',
            'Secretaría de Salud',
            'Control Interno',
            'Oficina Juridica',
            'Despacho del Alcalde',
            'Secretaría de Umata',
            'Secretaría de Educación',
            'Secretaría de Hacienda',
            'Sisben',
            'Talento Humano',
            'Secretaría de Transito y Transporte',
            'Gestion Social'
          ]
          && getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.dependencia == profile().dependencia
          && getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.dependenciasDestino.hasAny([request.resource.data.dependencia])
          && request.resource.data.radicado == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.radicado
          && request.resource.data.remitente == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.remitente
          && request.resource.data.asunto == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.asunto
          && request.resource.data.tipoCanal == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.tipoCanal
          && request.resource.data.fechaRadicacion == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.fechaRadicacion
          && request.resource.data.diasHabiles == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.diasHabiles
          && request.resource.data.fechaVencimiento == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.fechaVencimiento
          && request.resource.data.pdfUrl == getAfter(
            /databases/$(database)/documents/radicados/$(request.resource.data.remisionOrigenId)
          ).data.pdfUrl
          && request.resource.data.estado == 'VIGENTE'
          && request.resource.data.funcionarioAsignado == ''
          && request.resource.data.otrosEstados == ''
          && request.resource.data.respuestaUrl == ''
          && request.resource.data.observaciones == ''
          && request.resource.data.fechaEntregaManual == ''
          && request.resource.data.fechaRecepcionCompetencia == ''
          && request.resource.data.remisionOrigenRadicado == request.resource.data.radicado
        )
        || (
          isCiudadano()
          && request.resource.data.origenSolicitud == 'ciudadano'
          && request.resource.data.keys().hasAll([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaRecepcion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'pdfCiudadanoUrl',
            'pdfCiudadanoNombre',
            'dependencia',
            'ciudadanoUid',
            'anio',
            'numeroSecuencia'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'origenSolicitud',
            'estado',
            'tipoCanal',
            'fechaRadicacion',
            'fechaHoraRadicacion',
            'fechaRecepcion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'pdfUrl',
            'pdfCiudadanoUrl',
            'pdfCiudadanoNombre',
            'dependencia',
            'ciudadanoUid',
            'anio',
            'numeroSecuencia'
          ])
          && request.resource.data.ciudadanoUid == request.auth.uid
          && request.resource.data.anio is int
          && request.resource.data.numeroSecuencia is int
          && request.resource.data.numeroSecuencia > 0
          && request.resource.data.numeroSecuencia <= 99999
          && request.resource.data.radicado is string
          && request.resource.data.radicado.matches('^R-[0-9]{4}-[0-9]{5}$')
          && request.resource.data.radicado.size() > 0
          && request.resource.data.radicado.size() <= 100
          && request.resource.data.estado == 'PENDIENTE_GESTION'
          && request.resource.data.tipoCanal in ['Virtual', 'Presencial']
          && request.resource.data.fechaRadicacion is string
          && request.resource.data.fechaHoraRadicacion is string
          && request.resource.data.fechaRecepcion is string
          && request.resource.data.fechaEntregaManual is string
          && request.resource.data.diasHabiles is string
          && request.resource.data.fechaVencimiento is string
          && request.resource.data.remitente is string
          && request.resource.data.remitente.size() > 0
          && request.resource.data.remitente.size() <= 500
          && request.resource.data.asunto is string
          && request.resource.data.asunto.size() > 0
          && request.resource.data.asunto.size() <= 10000
          && request.resource.data.pdfUrl is string
          && request.resource.data.pdfUrl.size() <= 2000
          && request.resource.data.pdfCiudadanoUrl is string
          && request.resource.data.pdfCiudadanoUrl.size() <= 2000
          && request.resource.data.pdfCiudadanoNombre is string
          && request.resource.data.pdfCiudadanoNombre.size() <= 255
          && request.resource.data.dependencia == 'Ventanilla Única'
          && tieneSecuenciaCiudadanaDespues(
            request.resource.data.anio,
            request.resource.data.numeroSecuencia,
            request.resource.data.radicado
          )
          && tieneRadicadoCiudadanoDespues(
            request.resource.data.anio,
            request.resource.data.numeroSecuencia,
            request.resource.data.radicado
          )
        );
      allow update: if isAdmin()
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tipoPeticion',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'funcionarioAsignado',
            'otrosEstados',
            'observaciones',
            'estado'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.resource.data.estado == resource.data.estado
            || request.resource.data.estado in ['VIGENTE', 'EN TRAMITE', 'CERRADO']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuestaUrl'])
            || request.resource.data.respuestaUrl is string
          )
        )
        || (
          isAdministradorEstricto()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fechaVencimiento',
            'fechaEntrega',
            'prorroga',
            'actualizadoEn'
          ])
          && request.resource.data.fechaVencimiento is string
          && request.resource.data.fechaVencimiento > resource.data.fechaVencimiento
          && request.resource.data.prorroga is map
          && request.resource.data.prorroga.nuevaFecha is string
          && request.resource.data.prorroga.nuevaFecha == request.resource.data.fechaVencimiento
          && request.resource.data.prorroga.archivoUrl is string
          && request.resource.data.prorroga.archivoUrl.size() > 0
        )
        || (
          isAdministradorEstricto()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fechaVencimiento',
            'fechaEntrega',
            'prorroga',
            'actualizadoEn'
          ])
          && request.resource.data.fechaVencimiento is string
          && request.resource.data.fechaVencimiento > resource.data.fechaVencimiento
          && request.resource.data.prorroga is map
          && request.resource.data.prorroga.nuevaFecha is string
          && request.resource.data.prorroga.nuevaFecha == request.resource.data.fechaVencimiento
          && request.resource.data.prorroga.archivoUrl is string
          && request.resource.data.prorroga.archivoUrl.size() > 0
        )
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasDestino',
            'fechaRemisionCompetencia'
          ])
          && request.resource.data.dependenciasDestino is list
          && request.resource.data.dependenciasDestino.size()
            > resource.data.get('dependenciasDestino', []).size()
          && request.resource.data.dependenciasDestino.hasAll(
            resource.data.get('dependenciasDestino', [])
          )
          && request.resource.data.fechaRemisionCompetencia is string
          && request.resource.data.fechaRemisionCompetencia.size() > 0
        )
        || (
          isEmployeeOf(resource.data.dependencia)
          && request.resource.data.dependencia == resource.data.dependencia
          && resource.data.remisionOrigenId is string
          && resource.data.remisionOrigenId.size() > 0
          && (
            !resource.data.keys().hasAny(['fechaRecepcionCompetencia'])
            || resource.data.fechaRecepcionCompetencia == ''
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fechaEntregaManual',
            'fechaRecepcionCompetencia'
          ])
          && request.resource.data.fechaEntregaManual is string
          && request.resource.data.fechaRecepcionCompetencia is string
          && request.resource.data.fechaEntregaManual == request.resource.data.fechaRecepcionCompetencia
          && request.resource.data.fechaRecepcionCompetencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRecibidas',
            'recepcionesCompetencia',
            'estado'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'dependenciasRecibidas'
          ])
          && request.resource.data.estado == 'R. por C.'
          && request.resource.data.dependenciasRecibidas is list
          && request.resource.data.dependenciasRecibidas.size()
            == resource.data.get('dependenciasRecibidas', []).size() + 1
          && request.resource.data.dependenciasRecibidas.hasAll(
            resource.data.get('dependenciasRecibidas', [])
          )
          && request.resource.data.dependenciasRecibidas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRecibidas', []).hasAny([profile().dependencia])
          && request.resource.data.recepcionesCompetencia is list
          && request.resource.data.recepcionesCompetencia.size()
            == resource.data.get('recepcionesCompetencia', []).size() + 1
          && request.resource.data.recepcionesCompetencia.hasAll(
            resource.data.get('recepcionesCompetencia', [])
          )
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].fechaRecepcion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.dependencia == resource.data.dependencia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRechazadas',
            'rechazosCompetencia'
          ])
          && request.resource.data.dependenciasRechazadas is list
          && request.resource.data.dependenciasRechazadas.size()
            == resource.data.get('dependenciasRechazadas', []).size() + 1
          && request.resource.data.dependenciasRechazadas.hasAll(
            resource.data.get('dependenciasRechazadas', [])
          )
          && request.resource.data.dependenciasRechazadas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRechazadas', []).hasAny([profile().dependencia])
          && request.resource.data.rechazosCompetencia is list
          && request.resource.data.rechazosCompetencia.size()
            == resource.data.get('rechazosCompetencia', []).size() + 1
          && request.resource.data.rechazosCompetencia.hasAll(
            resource.data.get('rechazosCompetencia', [])
          )
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].fechaRechazo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
      allow delete: if isAdmin()
        || (
          isEmployeeOf(resource.data.dependencia)
          && resource.data.remisionOrigenId is string
          && resource.data.remisionOrigenId.size() > 0
          && (
            !resource.data.keys().hasAny(['fechaRecepcionCompetencia'])
            || resource.data.fechaRecepcionCompetencia == ''
          )
          && (
            (
              resource.data.get('remisionOrigenColeccion', 'radicados') == 'radicados'
              && getAfter(
                /databases/$(database)/documents/radicados/$(resource.data.remisionOrigenId)
              ).data.dependenciasRechazadas.hasAny([profile().dependencia])
            )
            || (
              resource.data.remisionOrigenColeccion == 'radicadosIAS'
              && getAfter(
                /databases/$(database)/documents/radicadosIAS/$(resource.data.remisionOrigenId)
              ).data.dependenciasRechazadas.hasAny([profile().dependencia])
            )
          )
        );
    }

    match /radicadosIAS/{radicadoId} {
      allow read: if canReadIAS();
      allow create: if canManageIAS()
        && request.resource.data.keys().hasOnly([
          'radicado',
          'entidadIAS',
          'destino',
          'tipoCanal',
          'estado',
          'fechaRadicacion',
          'fechaHoraRadicacion',
          'diasHabiles',
          'fechaVencimiento',
          'remitente',
          'asunto',
          'pdfUrl',
          'funcionarioAsignado',
          'tipoPeticion',
          'otrosEstados',
          'observaciones',
          'respuestaUrl',
          'fechaCargaRespuesta'
        ])
        && request.resource.data.keys().hasAll([
          'radicado',
          'entidadIAS',
          'destino',
          'tipoCanal',
          'estado',
          'fechaRadicacion',
          'diasHabiles',
          'fechaVencimiento',
          'remitente',
          'asunto',
          'pdfUrl'
        ])
        && request.resource.data.radicado is string
        && request.resource.data.entidadIAS is string
        && request.resource.data.destino is string
        && request.resource.data.fechaRadicacion is string
        && (
          !request.resource.data.keys().hasAny(['fechaHoraRadicacion'])
          || request.resource.data.fechaHoraRadicacion is string
        );
      allow update: if isAdmin()
        || (
          canManageIAS()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'radicado',
            'fechaRadicacion',
            'fechaEntregaManual',
            'diasHabiles',
            'fechaVencimiento',
            'remitente',
            'asunto',
            'funcionarioAsignado',
            'tipoPeticion',
            'respuestaUrl',
            'fechaCargaRespuesta',
            'estado',
            'otrosEstados',
            'observaciones'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
            || request.resource.data.estado in ['VIGENTE', 'EN TRAMITE', 'CERRADO', 'R. por C.']
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['respuestaUrl'])
            || request.resource.data.respuestaUrl is string
          )
        )
        || (
          isAdministradorEstricto()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fechaVencimiento',
            'fechaEntrega',
            'prorroga',
            'actualizadoEn'
          ])
          && request.resource.data.fechaVencimiento is string
          && request.resource.data.fechaVencimiento > resource.data.fechaVencimiento
          && request.resource.data.prorroga is map
          && request.resource.data.prorroga.nuevaFecha is string
          && request.resource.data.prorroga.nuevaFecha == request.resource.data.fechaVencimiento
          && request.resource.data.prorroga.archivoUrl is string
          && request.resource.data.prorroga.archivoUrl.size() > 0
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRecibidas',
            'recepcionesCompetencia',
            'estado'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'dependenciasRecibidas'
          ])
          && request.resource.data.estado == 'R. por C.'
          && request.resource.data.dependenciasRecibidas is list
          && request.resource.data.dependenciasRecibidas.size()
            == resource.data.get('dependenciasRecibidas', []).size() + 1
          && request.resource.data.dependenciasRecibidas.hasAll(
            resource.data.get('dependenciasRecibidas', [])
          )
          && request.resource.data.dependenciasRecibidas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRecibidas', []).hasAny([profile().dependencia])
          && request.resource.data.recepcionesCompetencia is list
          && request.resource.data.recepcionesCompetencia.size()
            == resource.data.get('recepcionesCompetencia', []).size() + 1
          && request.resource.data.recepcionesCompetencia.hasAll(
            resource.data.get('recepcionesCompetencia', [])
          )
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.recepcionesCompetencia[
            request.resource.data.recepcionesCompetencia.size() - 1
          ].fechaRecepcion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        || (
          isFuncionario()
          && resource.data.dependenciasDestino is list
          && resource.data.dependenciasDestino.hasAny([profile().dependencia])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dependenciasRechazadas',
            'rechazosCompetencia'
          ])
          && request.resource.data.dependenciasRechazadas is list
          && request.resource.data.dependenciasRechazadas.size()
            == resource.data.get('dependenciasRechazadas', []).size() + 1
          && request.resource.data.dependenciasRechazadas.hasAll(
            resource.data.get('dependenciasRechazadas', [])
          )
          && request.resource.data.dependenciasRechazadas.hasAny([profile().dependencia])
          && !resource.data.get('dependenciasRechazadas', []).hasAny([profile().dependencia])
          && request.resource.data.rechazosCompetencia is list
          && request.resource.data.rechazosCompetencia.size()
            == resource.data.get('rechazosCompetencia', []).size() + 1
          && request.resource.data.rechazosCompetencia.hasAll(
            resource.data.get('rechazosCompetencia', [])
          )
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].dependencia == profile().dependencia
          && request.resource.data.rechazosCompetencia[
            request.resource.data.rechazosCompetencia.size() - 1
          ].fechaRechazo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        );
      allow delete: if isAdmin();
    }

    match /radicadosSalida/{radicadoId} {
      allow get, list: if isAdmin() || isFuncionario() || isInvitado();
      allow create: if isAdmin()
        || (
          (isFuncionario() || isInvitado())
          && request.resource.data.keys().hasAll([
            'radicado',
            'dependencia',
            'destinatario',
            'asunto',
            'folios',
            'anexos',
            'claveIdempotencia',
            'numeroSecuencia',
            'anio',
            'mes',
            'fechaGeneracion',
            'horaGeneracion',
            'creadoEn',
            'actualizadoEn'
          ])
          && request.resource.data.keys().hasOnly([
            'radicado',
            'dependencia',
            'dependenciaOtra',
            'destinatario',
            'asunto',
            'folios',
            'anexos',
            'archivos',
            'claveIdempotencia',
            'numeroSecuencia',
            'anio',
            'mes',
            'fechaGeneracion',
            'horaGeneracion',
            'creadoEn',
            'actualizadoEn',
            'cantidadLote',
            'tipoLoteRadicados',
            'extremoLote'
          ])
        );
      allow update: if (
        isAdministradorEstricto()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estado',
              'anuladoEn',
              'actualizadoEn',
              'consecutivoAnulacion',
              'motivoAnulacion',
              'justificacionAnulacion',
              'usuarioAnulacion',
              'archivoAnulacion'
            ])
            && request.resource.data.estado == 'ANULADO'
            && request.resource.data.anuladoEn is string
            && request.resource.data.consecutivoAnulacion is string
            && request.resource.data.consecutivoAnulacion.matches('^ANU-[0-9]{4}-[0-9]{5}$')
            && request.resource.data.motivoAnulacion is string
            && request.resource.data.motivoAnulacion in [
              'Error de digitación',
              'Radicado duplicado',
              'Documento ilegible/erróneo',
              'Otro'
            ]
            && request.resource.data.justificacionAnulacion is string
            && request.resource.data.justificacionAnulacion.size() > 0
            && request.resource.data.archivoAnulacion is map
            && request.resource.data.archivoAnulacion.nombre is string
            && request.resource.data.archivoAnulacion.url is string
            && request.resource.data.archivoAnulacion.url.size() > 0
          )
        )
      ) || (
        isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'anuladoEn', 'archivoAnulacion'])
      ) || (
        (isFuncionario() || isInvitado())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dependencia',
          'destinatario',
          'asunto',
          'folios',
          'anexos',
          'dependenciaOtra',
          'archivos',
          'actualizadoEn'
        ])
      );
      allow delete: if isAdmin();
    }

    match /radicadosAnulacionSecuencias/{anioId} {
      allow get, list: if isAdmin();
      allow create: if isAdministradorEstricto()
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo > 0
        && request.resource.data.actualizadoEn is string;
      allow update: if isAdministradorEstricto()
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo > resource.data.ultimo
        && request.resource.data.actualizadoEn is string;
      allow delete: if false;
    }

    match /radicadosSalidaSecuencias/{secuenciaId} {
      allow get: if isAdmin() || isFuncionario() || isInvitado();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (
          (isFuncionario() || isInvitado())
          && request.resource.data.keys().hasOnly(['anio', 'ultimo'])
          && request.resource.data.anio is int
          && request.resource.data.ultimo is int
          && request.resource.data.ultimo > 0
        );
      allow update: if isAdmin()
        || (
          (isFuncionario() || isInvitado())
          && request.resource.data.keys().hasOnly(['anio', 'ultimo'])
          && request.resource.data.anio == resource.data.anio
          && request.resource.data.ultimo is int
          && resource.data.ultimo is int
          && request.resource.data.ultimo > resource.data.ultimo
          && request.resource.data.ultimo <= resource.data.ultimo + 400
        );
      allow delete: if isAdmin();
    }

    match /radicadosEntradaSecuencias/{anioId} {
      allow get: if isAdmin() || isCiudadano();
      allow list: if isAdmin();
      allow create: if (
        isAdmin()
        && request.resource.data.keys().hasAll(['anio', 'ultimo'])
        && request.resource.data.keys().hasOnly(['anio', 'ultimo', 'ultimoRadicado'])
        && request.resource.data.anio is int
        && string(request.resource.data.anio) == anioId
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo > 0
        && request.resource.data.ultimo <= 99999
        && (
          !request.resource.data.keys().hasAny(['ultimoRadicado'])
          || (
            request.resource.data.ultimoRadicado is string
            && request.resource.data.ultimoRadicado.matches('^R-[0-9]{4}-[0-9]{5}$')
          )
        )
      )
        || (
          isCiudadano()
          && request.resource.data.keys().hasAll(['anio', 'ultimo', 'ultimoRadicado'])
          && request.resource.data.keys().hasOnly(['anio', 'ultimo', 'ultimoRadicado'])
          && request.resource.data.anio is int
          && string(request.resource.data.anio) == anioId
          && request.resource.data.ultimo == 1
          && request.resource.data.ultimoRadicado is string
          && request.resource.data.ultimoRadicado.matches('^R-[0-9]{4}-[0-9]{5}$')
          && tieneRadicadoCiudadanoDespues(
            request.resource.data.anio,
            request.resource.data.ultimo,
            request.resource.data.ultimoRadicado
          )
        );
      allow update: if (
        isAdmin()
        && request.resource.data.keys().hasAll(['anio', 'ultimo'])
        && request.resource.data.keys().hasOnly(['anio', 'ultimo', 'ultimoRadicado'])
        && request.resource.data.anio == resource.data.anio
        && request.resource.data.ultimo is int
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && request.resource.data.ultimo <= 99999
        && (
          !request.resource.data.keys().hasAny(['ultimoRadicado'])
          || (
            request.resource.data.ultimoRadicado is string
            && request.resource.data.ultimoRadicado.matches('^R-[0-9]{4}-[0-9]{5}$')
          )
        )
      )
        || (
          isCiudadano()
          && request.resource.data.keys().hasAll(['anio', 'ultimo', 'ultimoRadicado'])
          && request.resource.data.keys().hasOnly(['anio', 'ultimo', 'ultimoRadicado'])
          && request.resource.data.anio == resource.data.anio
          && string(request.resource.data.anio) == anioId
          && request.resource.data.ultimo is int
          && request.resource.data.ultimo == resource.data.ultimo + 1
          && request.resource.data.ultimo <= 99999
          && request.resource.data.ultimoRadicado is string
          && request.resource.data.ultimoRadicado.matches('^R-[0-9]{4}-[0-9]{5}$')
          && tieneRadicadoCiudadanoDespues(
            request.resource.data.anio,
            request.resource.data.ultimo,
            request.resource.data.ultimoRadicado
          )
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
